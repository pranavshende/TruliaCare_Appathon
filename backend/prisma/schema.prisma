generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("EMPLOYEE")
  isActive  Boolean  @default(true)
  pushToken String?  // Expo Push Token for mobile notifications
  skills    String[] // Array of skills for Technician Routing
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestsCreated MaintenanceRequest[] @relation("EmployeeRequests")
  requestsAssigned MaintenanceRequest[] @relation("AssignedRequests")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model MaintenanceRequest {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String   // IT, FACILITY, ELECTRICAL, PLUMBING, HVAC, OTHER
  priority    String   // LOW, MEDIUM, HIGH, CRITICAL
  imageUrl    String?  // URL of the uploaded photo
  location    String?  // The specific location, e.g. "3rd Floor Washroom"
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, ESCALATED, RESOLVED
  isAutoGenerated Boolean @default(false) // True if created from anonymous flags

  employeeId  String?
  employee    User?    @relation("EmployeeRequests", fields: [employeeId], references: [id])

  technicianId String?
  technician   User?    @relation("AssignedRequests", fields: [technicianId], references: [id])

  // Maintenance Cost & Work Tracking
  workPerformed  String?
  resourcesUsed  String?
  cost           Float?
  timeSpentHours Float?
  resolvedAt     DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  acceptedAt  DateTime? // Set when technician accepts the ticket
  escalatedAt DateTime?

  escalationLogs EscalationLog[]
  emailLogs      EmailLog[]
}

model EscalationLog {
  id             String   @id @default(cuid())
  requestId      String
  request        MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  previousStatus String
  newStatus      String
  reason         String?
  escalatedTo    String? // e.g. Admin ID or Role
  escalationType String   @default("AUTOMATIC") // AUTOMATIC, MANUAL
  createdAt      DateTime @default(now())
}

model EmailLog {
  id               String   @id @default(cuid())
  requestId        String
  request          MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  recipient        String
  subject          String
  notificationType String   @default("REQUEST_ESCALATED")
  status           String   // SENT, FAILED
  messageId        String?
  error            String?
  createdAt        DateTime @default(now())
}

model LocationFeedback {
  id        String   @id @default(cuid())
  location  String
  rating    Int      // 1 to 5 (e.g. 1, 2 = negative)
  createdAt DateTime @default(now())
}

model AnonymousFlag {
  id        String   @id @default(cuid())
  location  String
  category  String
  createdAt DateTime @default(now())
}
