generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("EMPLOYEE") // EMPLOYEE, ADMIN, TECHNICIAN
  isActive  Boolean  @default(true)
  pushToken String?  // Mobile / Expo push notification token
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestsCreated  MaintenanceRequest[] @relation("EmployeeRequests")
  requestsAssigned MaintenanceRequest[] @relation("AssignedRequests")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model MaintenanceRequest {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String   // IT, FACILITY, ELECTRICAL, PLUMBING, HVAC, OTHER
  priority    String   // LOW, MEDIUM, HIGH, CRITICAL
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, ESCALATED, RESOLVED

  employeeId  String
  employee    User     @relation("EmployeeRequests", fields: [employeeId], references: [id])

  technicianId String?
  technician   User?    @relation("AssignedRequests", fields: [technicianId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  escalatedAt DateTime?

  escalationLogs EscalationLog[]
  emailLogs      EmailLog[]

  @@index([status])
  @@index([employeeId])
  @@index([technicianId])
  @@index([category])
}

model EscalationLog {
  id             String             @id @default(cuid())
  requestId      String
  request        MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  previousStatus String
  newStatus      String
  reason         String?
  escalatedTo    String?            // SYSTEM or Admin ID
  escalationType String             @default("AUTOMATIC") // AUTOMATIC, MANUAL
  createdAt      DateTime           @default(now())

  @@index([requestId])
}

model EmailLog {
  id               String             @id @default(cuid())
  requestId        String
  request          MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  recipient        String
  subject          String
  notificationType String             @default("REQUEST_ESCALATED")
  status           String             // SENT, FAILED
  messageId        String?
  error            String?
  createdAt        DateTime           @default(now())

  @@index([requestId])
  @@index([status])
}
